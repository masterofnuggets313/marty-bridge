{
  "manifest_version": 3,
  "name": "Marty Bridge",
  "version": "1.1",
  "description": "Прямое управление браузером для внешнего агента",
  "permissions": ["debugger", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8765/*"],
      "js": ["keepalive.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
